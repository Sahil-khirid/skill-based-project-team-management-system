# Environment variable template for the Skill-Based Project Team Management System.
#
# This file contains no secrets. It is a reference template only — it is NOT
# automatically loaded by the application. Plain Spring Boot does not read a
# .env file; environment variables must be set through the operating system
# shell, your IDE's run configuration, or the deployment environment. Never
# commit a real, filled-in .env file.
#
# ---------------------------------------------------------------------------
# Milestone 1 — Eureka Server
# ---------------------------------------------------------------------------
# The Eureka Server introduced in this milestone requires NO environment
# variables. It runs out of the box using
# backend/eureka-server/src/main/resources/application.yml.
#
# There is currently nothing to configure in this file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone 2 — API Gateway
# ---------------------------------------------------------------------------
# Optional. Overrides the Eureka registry URL the API Gateway registers
# with. Defaults to http://localhost:8761/eureka/ if unset.
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone 3 — Auth Service
# ---------------------------------------------------------------------------
# Optional. Overrides the Eureka registry URL the Auth Service registers
# with. Defaults to http://localhost:8761/eureka/ if unset. Shared with the
# variable declared above.
# EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# Optional. Overrides the JDBC URL the Auth Service uses for its own
# database (skillteam_auth). Defaults to a local MySQL instance if unset.
AUTH_DB_URL=jdbc:mysql://localhost:3306/skillteam_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Optional. Database username. Defaults to root if unset.
AUTH_DB_USERNAME=root

# Required for a real MySQL connection. Left blank here intentionally — do
# NOT commit a real password. Set this in your shell, IDE run configuration,
# or deployment environment.
AUTH_DB_PASSWORD=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone 4 — Auth Login and JWT Security Foundation
# Milestone 5 — API Gateway Auth Routing and JWT Security Integration
# ---------------------------------------------------------------------------
# Required. The HMAC-SHA256 (HS256) signing secret for JWT access tokens,
# encoded as Base64. Requirements:
#   - Must be Base64-encoded text.
#   - The DECODED key must contain at least 32 cryptographically random bytes.
#   - It must NEVER be committed to source control — leave this blank here.
#   - This .env.example file is a reference template only; it is NOT
#     automatically loaded by Spring Boot. The real value must be supplied
#     through your shell (PowerShell/CMD), your IDE's run configuration, or
#     the deployment environment.
#
# IMPORTANT: The exact same JWT_SECRET_BASE64 value must be supplied to BOTH
# the Auth Service and the API Gateway. The Gateway validates the signature,
# expiration, issuer, and audience of tokens issued by the Auth Service — if
# the two processes are given different secrets, every Gateway-protected
# request will fail JWT validation. There is no separate Gateway-only secret,
# and there is no fallback/default secret for either process.
#
# Generate a random 32-byte Base64 secret in PowerShell:
#   $bytes = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   [Convert]::ToBase64String($bytes)
JWT_SECRET_BASE64=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone 6 — Auth Refresh Token Rotation and Logout
# ---------------------------------------------------------------------------
# Optional. ISO-8601 duration controlling how long an opaque refresh token
# (issued at login and rotated at /api/v1/auth/refresh) remains valid.
# Refresh tokens are unrelated to and do not change the JWT access-token TTL.
# Defaults to P7D (7 days) if unset.
REFRESH_TOKEN_TTL=P7D
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone 7A — Project & Team Service Foundation
# ---------------------------------------------------------------------------
# Optional. Overrides the JDBC URL the Project & Team Service uses for its
# own database (skillteam_project). Defaults to a local MySQL instance if
# unset.
PROJECT_TEAM_DB_URL=jdbc:mysql://localhost:3306/skillteam_project?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Optional. Database username. Defaults to root if unset.
PROJECT_TEAM_DB_USERNAME=root

# Required for a real MySQL connection. Left blank here intentionally — do
# NOT commit a real password. Set this in your shell, IDE run configuration,
# or deployment environment.
PROJECT_TEAM_DB_PASSWORD=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone T1-T5 — Task & Progress Service Foundation
# ---------------------------------------------------------------------------
# Optional. Overrides the JDBC URL the Task & Progress Service uses for its
# own database (skillteam_task). Defaults to a local MySQL instance if
# unset.
TASK_PROGRESS_DB_URL=jdbc:mysql://localhost:3306/skillteam_task?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Optional. Database username. Defaults to root if unset.
TASK_PROGRESS_DB_USERNAME=root

# Required for a real MySQL connection. Left blank here intentionally — do
# NOT commit a real password. Set this in your shell, IDE run configuration,
# or deployment environment.
TASK_PROGRESS_DB_PASSWORD=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone — Frontend Browser Integration (API Gateway CORS)
# ---------------------------------------------------------------------------
# Optional. The browser origins allowed to call the API Gateway directly
# (scheme + host + port). These are the origins the React (Vite) frontend
# runs on in local development. Defaults to the values below if unset.
#
# These are not secrets - they are safe to see in a browser's own network
# requests. Do NOT use a wildcard ("*") origin. In production, set these to
# the actual deployed frontend origin(s) instead of the local defaults.
FRONTEND_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_ALLOWED_ORIGIN_ALT=http://127.0.0.1:5173
# ---------------------------------------------------------------------------
#
# Future services will document their own required variables here when they
# are implemented.
