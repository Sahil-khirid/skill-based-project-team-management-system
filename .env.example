# Environment variable template for the Skill-Based Project Team Management System.
#
# This file contains no secrets. It is a reference template only — it is NOT
# automatically loaded by the application. Plain Spring Boot does not read a
# .env file; environment variables must be set through the operating system
# shell, your IDE's run configuration, or the deployment environment. Never
# commit a real, filled-in .env file.
#
# ---------------------------------------------------------------------------
# Milestone 1 — Eureka Server
# ---------------------------------------------------------------------------
# The Eureka Server introduced in this milestone requires NO environment
# variables. It runs out of the box using
# backend/eureka-server/src/main/resources/application.yml.
#
# There is currently nothing to configure in this file.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone 2 — API Gateway
# ---------------------------------------------------------------------------
# Optional. Overrides the Eureka registry URL the API Gateway registers
# with. Defaults to http://localhost:8761/eureka/ if unset.
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Milestone 3 — Auth Service
# ---------------------------------------------------------------------------
# Optional. Overrides the Eureka registry URL the Auth Service registers
# with. Defaults to http://localhost:8761/eureka/ if unset. Shared with the
# variable declared above.
# EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# Optional. Overrides the JDBC URL the Auth Service uses for its own
# database (skillteam_auth). Defaults to a local MySQL instance if unset.
AUTH_DB_URL=jdbc:mysql://localhost:3306/skillteam_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Optional. Database username. Defaults to root if unset.
AUTH_DB_USERNAME=root

# Required for a real MySQL connection. Left blank here intentionally — do
# NOT commit a real password. Set this in your shell, IDE run configuration,
# or deployment environment.
AUTH_DB_PASSWORD=
# ---------------------------------------------------------------------------
#
# Future services will document their own required variables here when they
# are implemented.
