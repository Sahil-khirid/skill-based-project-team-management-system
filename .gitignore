# Java / Spring Boot
target/
*.class
*.jar
*.war

# Maven Wrapper (mvnw, mvnw.cmd, .mvn/wrapper) is intentionally NOT ignored.
# It must be committed so all team members build with the same Maven version.

# IDE files
.idea/
*.iml
.project
.classpath
.settings/

# VS Code
.vscode/

# Eclipse
.metadata/
bin/

# Logs
*.log

# React / Node
node_modules/
build/
dist/

# Environment / secrets — local, machine-specific configuration only.
# .env.example is intentionally NOT ignored; it is safe to commit.
.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-local.yaml

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*~
*.swp